{
  "name": "social-content-mcp",
  "version": "0.1.2",
  "description": "Brand kit in, on-brand posts and reels out: an MCP server for engagement posts (Penpot designs, 20-30 s reels, history-aware rotation).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "keeper": "node dist/cli.js keeper",
    "spike:penpot": "tsx scripts/penpot-spike.ts",
    "bench:reel": "tsx scripts/bench-reel.ts",
    "pack": "node scripts/pack.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.2.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.65.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "bin": {
    "social-content-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
